# Vigilia Frontend Environment Configuration
# API Gateway address (Spring Boot microservices gateway on port 8080)
VITE_API_URL=http://localhost:8080

# Environment name: development, staging, production
VITE_APP_ENV=development

# App Version
VITE_APP_VERSION=1.0.0

# Mock Mode toggle: set to false to connect directly to Gateway, true for standalone demo
VITE_ENABLE_MOCK_FALLBACK=true

